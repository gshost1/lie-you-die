# Copy to .env and fill in. Never commit .env.
#
# Harness host (Mac) only, never placed on a VM:
FREESTYLE_API_KEY=
# DO inference key. On VMs it is injected at the Freestyle edge; the VM sees a placeholder.
MODEL_API_KEY=
# Ramp Router key: Jev + gpt-6-sol judges (from the Mac), and claude-sonnet-5-5 agent runs
# (injected at the Freestyle edge for api.router.com; the VM sees a placeholder):
ROUTER_API_KEY=
# Extra Ramp Router accounts (separate credit). Check with `bun run router-accounts`;
# a model profile in config/agents.json picks one via apiKeyEnv:
ROUTER_API_KEY_2=
ROUTER_API_KEY_3=
ROUTER_API_KEY_4=
# Older name for the same Router key; used only if ROUTER_API_KEY is unset:
JEV_API_KEY=
#
# droid only. Injected at the Freestyle edge (factoryKeyMode "edge"); put on the VM only on
# the env fallback or when factoryKeyMode is "env":
FACTORY_API_KEY=
